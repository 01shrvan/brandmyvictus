---
import Base from "@/layouts/Base.astro";
import { SITE } from "@/lib/site";

export const prerender = false;
---

<Base title="not here">
  <main class="mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-gutter py-16">
    <p class="data text-ink-dim">404</p>
    <h1 class="mt-3 text-step-1 font-semibold">nothing on this spot</h1>
    <p class="mt-2 text-step--1 text-ink-soft">
      the page you wanted isnt here. the auction is on the front page, eleven spots on a black hp victus.
    </p>
    <div class="mt-6 flex flex-wrap gap-2.5">
      <a href="/" class="btn btn-signal">back to the auction</a>
      <a href={SITE.home} class="btn">about me</a>
    </div>
  </main>
</Base>
