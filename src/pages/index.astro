---
import Base from "@/layouts/Base.astro";
import CornerBar from "@/components/CornerBar.astro";
import LidPanel from "@/components/LidPanel.astro";
import SpotList from "@/components/SpotList.astro";
import BidDialog from "@/components/BidDialog.astro";
import Money from "@/components/Money.astro";
import { buildBoard, loadBoard, type Board } from "@/lib/auction";
import { AUCTION, FAQ, MACHINE, SITE, SPOTS, STEPS } from "@/lib/site";
import { formatInr } from "@/lib/money";

export const prerender = false;

let board: Board;
try {
  board = await loadBoard();
} catch (error) {
  console.error("board load failed", error instanceof Error ? error.message : "unknown");
  board = buildBoard(false, []);
}

Astro.response.headers.set("cache-control", "no-store");

const taken = board.spots.filter((s) => s.leader).length;
const pct = Math.round((board.raised / AUCTION.goal) * 100);
const closes = new Date(AUCTION.closesAt);
const daysLeft = Math.max(0, Math.ceil((closes.getTime() - Date.now()) / 86400000));
const closeLabel = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "Asia/Kolkata" })
  .format(closes)
  .toLowerCase();
const cheapest = Math.min(...SPOTS.map((s) => s.start));

const ago = (iso: string) => {
  const minutes = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.round(minutes / 60);
  return hours < 48 ? `${hours}h ago` : `${Math.round(hours / 24)}d ago`;
};
const labelFor = (id: number) => SPOTS.find((s) => s.id === id)?.label ?? "";
---

<Base>
  <CornerBar corner={board.corner} history={board.cornerHistory} />

  <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(25rem,1fr)]">
    <LidPanel spots={board.spots} />

    <main id="main" class="min-w-0 lg:border-l">
      <section class="anim-rise px-gutter pt-12 pb-10 lg:pt-16">
        <p class="data text-ink-dim">an auction by {SITE.aka} · closes {closeLabel}</p>
        <h1 class="mt-5 text-hero leading-[0.95] font-semibold tracking-[-0.035em]">
          your logo<br />on my victus
        </h1>
        <p class="mt-5 max-w-[34ch] text-step-1 leading-snug text-ink-soft">
          the laptop i build everything on goes to cafes, college, meetups and every screen recording i post. put your brand on it
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-2.5">
          <a href="#spots" class="btn btn-signal">pick a spot, from <Money inr={cheapest} /></a>
          <a href="#how" class="btn">how it works</a>
        </div>
      </section>

      <section class="grid grid-cols-2 border-y" aria-label="auction so far">
        <div class="border-r border-b px-gutter py-5">
          <p class="data text-ink-dim">in bids</p>
          <p class="mt-1.5 text-step-1 font-medium"><Money inr={board.raised} /></p>
        </div>
        <div class="border-b px-gutter py-5">
          <p class="data text-ink-dim">of {formatInr(AUCTION.goal)}</p>
          <p class="mt-1.5 text-step-1 font-medium tabular-nums">{pct}%</p>
        </div>
        <div class="border-r px-gutter py-5">
          <p class="data text-ink-dim">closes in</p>
          <p class="mt-1.5 flex items-center gap-2 text-step-1 font-medium tabular-nums">
            {!board.closed && <span class="anim-dot inline-block size-2 rounded-full bg-signal ring-1 ring-ink/20" />}
            {board.closed ? "closed" : `${daysLeft} days`}
          </p>
        </div>
        <div class="px-gutter py-5">
          <p class="data text-ink-dim">{taken} of {board.spots.length} taken</p>
          <div class="mt-3 flex gap-1" aria-hidden="true">
            {board.spots.map((s) => <span class:list={["h-3 flex-1 rounded-[3px]", s.leader ? "bg-lid" : "border border-line-strong"]} />)}
          </div>
        </div>
      </section>

      <section id="spots" class="scroll-mt-4 pt-12">
        <div class="flex items-baseline justify-between px-gutter pb-3">
          <h2 class="text-step-1 font-medium">spots</h2>
          <p class="data text-ink-dim">{board.connected ? `${board.totalBids} bids so far` : "bidding opens soon"}</p>
        </div>
        <SpotList spots={board.spots} closed={board.closed} />
      </section>

      <section class="px-gutter pt-12">
        <h2 class="text-step-1 font-medium">latest bids</h2>
        {
          board.recent.length === 0 ? (
            <p class="mt-3 text-step--1 text-ink-dim">nothing yet. the first bid sets the pace</p>
          ) : (
            <ul class="mt-3">
              {board.recent.map((bid) => (
                <li class="flex items-baseline gap-3 border-b py-2.5 text-step--1">
                  <span class="data w-16 shrink-0 text-ink-dim">{ago(bid.createdAt)}</span>
                  <span class="min-w-0 flex-1 truncate">
                    <span class:list={["font-medium", bid.status === "outbid" && "text-ink-dim line-through"]}>{bid.brand}</span>
                    <span class="text-ink-dim"> on {labelFor(bid.spotId)}</span>
                  </span>
                  <Money inr={bid.amount} class="data shrink-0" />
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <section id="how" class="scroll-mt-4 px-gutter pt-14">
        <h2 class="text-step-1 font-medium">how it works</h2>
        <ol class="mt-4 space-y-5">
          {
            STEPS.map((step, i) => (
              <li class="grid grid-cols-[2.2rem_minmax(0,1fr)] gap-x-3">
                <span class="data pt-[0.3em] text-ink-dim">0{i + 1}</span>
                <div>
                  <p class="font-medium">{step.title}</p>
                  <p class="mt-1 text-step--1 leading-relaxed text-ink-soft">{step.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="machine" class="scroll-mt-4 px-gutter pt-14">
        <h2 class="text-step-1 font-medium">the machine</h2>
        <dl class="mt-3">
          {
            MACHINE.map((row) => (
              <div class="grid grid-cols-[5rem_minmax(0,1fr)] gap-x-3 border-b py-2">
                <dt class="data pt-[0.25em] text-ink-dim">{row.label}</dt>
                <dd class="text-step--1">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="faq" class="scroll-mt-4 px-gutter pt-14">
        <h2 class="text-step-1 font-medium">questions</h2>
        <div class="mt-3 border-t">
          {
            FAQ.map((item) => (
              <details class="group border-b">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 text-step--1 font-medium transition-colors hover:text-ink-soft [&::-webkit-details-marker]:hidden">
                  {item.q}
                  <span class="grid size-5 shrink-0 place-items-center rounded-full border border-line-strong text-ink-dim transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
                </summary>
                <p class="pb-4 text-step--1 leading-relaxed text-ink-soft">{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <footer class="mt-16 border-t px-gutter py-6">
        <p class="text-step--1 text-ink-soft">
          by <a href={SITE.home} class="link">{SITE.owner}</a>, {SITE.location}. questions to <a href={SITE.x} class="link">@01shrvan</a>
        </p>
        <p class="data mt-3 text-ink-dim">hp and victus are trademarks of hp inc. this auction isnt affiliated with hp</p>
      </footer>
    </main>
  </div>

  <BidDialog spots={[board.corner, ...board.spots]} />
</Base>
