---
import { SITE } from "@/lib/site";

const NAV = [
  { href: "#auction", label: "auction" },
  { href: "#how", label: "how it works" },
  { href: "#machine", label: "machine" },
  { href: "#faq", label: "faq" },
];

const clock = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Asia/Kolkata",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
}).format(new Date());
---

<div class="flex min-h-dvh flex-col overflow-x-clip">
  <div class="mx-auto flex w-full max-w-sheet flex-1 flex-col border-x">
    <header class="sticky top-0 z-30 border-b bg-ground/92 backdrop-blur-md">
      <div class="relative flex h-12 items-center justify-between gap-3 px-gutter">
        <a href="/" class="shrink-0 text-step--1 font-medium transition-colors duration-200 hover:text-cobalt">
          {SITE.name}
        </a>

        <nav class="flex min-w-0 items-center gap-3 sm:gap-5" aria-label="Primary">
          {
            NAV.map(({ href, label }) => (
              <a href={href} class="hidden text-step--1 text-ink-soft transition-colors duration-200 hover:text-ink md:inline">
                {label}
              </a>
            ))
          }
          <button
            type="button"
            data-currency-toggle
            class="data grid h-7 shrink-0 grid-cols-2 border text-ink-soft"
            aria-label="Switch currency"
          >
            <span class="currency-opt px-1.5 leading-[1.6rem]" data-opt="inr">₹</span>
            <span class="currency-opt px-1.5 leading-[1.6rem]" data-opt="usd">$</span>
          </button>
          <button
            type="button"
            data-theme-toggle
            class="grid size-7 shrink-0 place-items-center text-ink-soft transition-colors duration-200 hover:text-cobalt"
            aria-label="Switch theme"
          >
            <svg class="col-start-1 row-start-1 size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
            <svg class="col-start-1 row-start-1 hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
          <a href="#spots" class="btn btn-cobalt hidden sm:inline-flex">get a spot</a>
        </nav>

        <span class="reg-mark bottom-0 left-0"></span>
        <span class="reg-mark bottom-0 left-full"></span>
      </div>
      <slot name="bar" />
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-20 border-t px-gutter py-5">
      <div class="data flex flex-wrap items-center justify-between gap-x-4 gap-y-2 lowercase text-ink-soft">
        <a href={SITE.home} class="shrink-0 text-ink transition-colors hover:text-cobalt">@{SITE.aka}</a>
        <span class="truncate">{SITE.location}</span>
        <span class="shrink-0"><time data-clock class="text-ink">{clock}</time> ist</span>
        <span class="w-full sm:w-auto">hp and victus are trademarks of hp inc. not affiliated</span>
      </div>
    </footer>
  </div>
</div>

<style is:global>
  .currency-opt[data-opt="inr"] {
    background: var(--color-ink);
    color: var(--color-ground);
  }
  :root[data-currency="usd"] .currency-opt[data-opt="inr"] {
    background: transparent;
    color: inherit;
  }
  :root[data-currency="usd"] .currency-opt[data-opt="usd"] {
    background: var(--color-ink);
    color: var(--color-ground);
  }
</style>

<script>
  const root = document.documentElement;

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;

    if (target?.closest("[data-theme-toggle]")) {
      const next = root.classList.contains("dark") ? "light" : "dark";
      root.classList.toggle("dark", next === "dark");
      root.classList.toggle("light", next === "light");
      try {
        localStorage.setItem("theme", next);
      } catch {}
    }

    if (target?.closest("[data-currency-toggle]")) {
      const next = root.dataset.currency === "usd" ? "inr" : "usd";
      if (next === "usd") root.dataset.currency = "usd";
      else delete root.dataset.currency;
      try {
        localStorage.setItem("currency", next);
      } catch {}
    }
  });

  const fmt = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Kolkata",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });
  const el = document.querySelector("[data-clock]");
  if (el) {
    const tick = () => (el.textContent = fmt.format(new Date()));
    setTimeout(() => {
      tick();
      setInterval(tick, 1000);
    }, 1000 - (Date.now() % 1000));
  }
</script>
