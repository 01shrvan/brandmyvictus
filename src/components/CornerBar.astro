---
import type { Bid, SpotState } from "@/lib/auction";
import Money from "@/components/Money.astro";

interface Props {
  corner: SpotState;
  history: Bid[];
}

const { corner, history } = Astro.props;
const leader = corner.leader;

const since = (iso: string | null) => {
  if (!iso) return "";
  const minutes = Math.max(1, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
  if (minutes < 60) return `${minutes}m`;
  const hours = Math.round(minutes / 60);
  return hours < 48 ? `${hours}h` : `${Math.round(hours / 24)}d`;
};

---

<div class="flex min-h-10 items-center gap-3 border-b px-gutter py-2 text-step--1">
  <span class="data shrink-0 rounded-full bg-signal px-2 py-0.5 text-ink">the corner</span>
  {
    leader ? (
      <span class="flex min-w-0 items-center gap-2">
        {leader.url ? (
          <a
            href={`${leader.url}${leader.url.includes("?") ? "&" : "?"}utm_source=victus.shrvan.xyz&utm_medium=corner`}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="truncate font-medium underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-ink"
          >
            {leader.brand}
          </a>
        ) : (
          <span class="truncate font-medium">{leader.brand}</span>
        )}
        <span class="data hidden shrink-0 text-ink-dim sm:inline">
          here for {since(leader.liveAt)}
          {history.length > 1 && `, ${history.length - 1} before`}
        </span>
      </span>
    ) : (
      <span class="truncate text-ink-soft">empty right now, first one gets it cheap</span>
    )
  }
  <button type="button" data-open-bid={corner.id} class="ml-auto shrink-0 text-ink-soft transition-colors hover:text-ink">
    take it for <Money inr={corner.min} class="font-medium text-ink" />
  </button>
</div>
