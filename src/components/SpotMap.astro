---
import type { SpotState } from "@/lib/auction";
import SpotPlot from "@/components/SpotPlot.astro";
import { LID } from "@/lib/site";

interface Props {
  spots: SpotState[];
}

const { spots } = Astro.props;
const lid = spots.filter((s) => s.zone === "lid");
const deck = spots.filter((s) => s.zone === "deck");
const brick = spots.filter((s) => s.zone === "brick");
const { w: W, h: H, mark } = LID;
---

<div class="border-y">
  <div class="relative px-gutter pt-5 pb-6">
    <p class="data flex flex-wrap items-baseline gap-x-3 lowercase text-ink-soft">
      <span class="text-ink">view a</span>
      <span>lid, as the table across from me sees it</span>
      <span class="leader hidden sm:block"></span>
      <span>scale 1:1 mm, grid 10 mm</span>
    </p>

    <svg viewBox="-30 -30 418 316" class="mt-3 block h-auto w-full" role="group" aria-label="lid sticker spots">
      <defs>
        <pattern id="grid10" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
          <path d="M 10 0 L 0 0 0 10" class="fill-none stroke-rule" stroke-width="0.25"></path>
        </pattern>
      </defs>

      <rect x="-30" y="-30" width="418" height="316" fill="url(#grid10)" opacity="0.55"></rect>

      <g class="stroke-rule-strong" stroke-width="0.35" fill="none">
        <path d="M 0 -4 V -21 M 357.9 -4 V -21 M -4 0 H -21 M -4 255 H -21"></path>
        <path d="M 0 -15 H 357.9 M -15 0 V 255"></path>
        <path d="M -2.4 -12.6 L 2.4 -17.4 M 355.5 -12.6 L 360.3 -17.4 M -17.4 2.4 L -12.6 -2.4 M -17.4 257.4 L -12.6 252.6" stroke-width="0.6"></path>
      </g>
      <rect x="164" y="-20" width="30" height="9" class="fill-ground"></rect>
      <text x="178.95" y="-15.2" font-size="5" text-anchor="middle" dominant-baseline="middle" class="svg-mono fill-ink-soft">357.9</text>
      <rect x="-20" y="115" width="10" height="25" class="fill-ground"></rect>
      <text x="-15" y="127.5" font-size="5" text-anchor="middle" dominant-baseline="middle" transform="rotate(-90 -15 127.5)" class="svg-mono fill-ink-soft">255</text>

      <rect x="0" y="0" width={W} height={H} rx="9" pathLength="100" class="anim-draw fill-ground stroke-ink" style="--len:100" stroke-width="0.9"></rect>

      <path d={`M -6 ${H / 2} H ${W + 6} M ${W / 2} -6 V ${H + 6}`} class="fill-none stroke-rule-strong" stroke-width="0.3" stroke-dasharray="9 2 1.5 2" opacity="0.7"></path>

      <circle cx={mark.x} cy={mark.y} r={mark.r} class="fill-ground stroke-rule-strong" stroke-width="0.4" stroke-dasharray="2 1.6"></circle>
      <path d={`M ${mark.x - 7} ${mark.y - 6} L ${mark.x} ${mark.y + 7} L ${mark.x + 7} ${mark.y - 6}`} class="fill-none stroke-ink-soft" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <text x={mark.x} y={mark.y + mark.r + 6} font-size="3.8" text-anchor="middle" class="svg-mono fill-ink-soft">mark, keep clear</text>

      <path d="M 26 243 H 331.9" class="stroke-rule-strong" stroke-width="0.4"></path>
      <text x={W / 2} y="251" font-size="3.8" text-anchor="middle" class="svg-mono fill-ink-soft">hinge</text>

      {lid.map((spot) => <SpotPlot spot={spot} />)}
    </svg>
  </div>

  <div class="grid border-t sm:grid-cols-[1.6fr_1fr]">
    <div class="px-gutter pt-5 pb-6 sm:border-r">
      <p class="data flex flex-wrap items-baseline gap-x-3 lowercase text-ink-soft">
        <span class="text-ink">view b</span>
        <span>deck, from above</span>
        <span class="leader hidden sm:block"></span>
        <span>1:1 mm</span>
      </p>
      <svg viewBox="-6 -8 370 272" class="mt-3 block h-auto w-full" role="group" aria-label="deck sticker spots">
        <defs>
          <pattern id="keys-main" x="16" y="20" width="16.66" height="19.33" patternUnits="userSpaceOnUse">
            <rect x="1" y="1" width="14.66" height="17.33" rx="1.4" class="fill-none stroke-rule-strong" stroke-width="0.3"></rect>
          </pattern>
          <pattern id="keys-num" x="274" y="20" width="17" height="19.33" patternUnits="userSpaceOnUse">
            <rect x="1" y="1" width="15" height="17.33" rx="1.4" class="fill-none stroke-rule-strong" stroke-width="0.3"></rect>
          </pattern>
        </defs>
        <rect x="0" y="0" width={W} height={H} rx="9" class="fill-ground stroke-ink" stroke-width="0.9"></rect>
        <path d="M 30 6 H 327.9" class="stroke-rule-strong" stroke-width="0.4"></path>
        <rect x="16" y="20" width="250" height="116" fill="url(#keys-main)"></rect>
        <rect x="274" y="20" width="68" height="116" fill="url(#keys-num)"></rect>
        <rect x="97" y="150" width="110" height="72" rx="3" class="fill-none stroke-rule-strong" stroke-width="0.5"></rect>
        <text x="152" y="189" font-size="4" text-anchor="middle" class="svg-mono fill-ink-dim">touchpad</text>
        {deck.map((spot) => <SpotPlot spot={spot} />)}
      </svg>
    </div>

    <div class="border-t px-gutter pt-5 pb-6 sm:border-t-0">
      <p class="data flex flex-wrap items-baseline gap-x-3 lowercase text-ink-soft">
        <span class="text-ink">view c</span>
        <span>charger brick</span>
        <span class="leader hidden sm:block"></span>
        <span>n.t.s.</span>
      </p>
      <svg viewBox="0 0 170 92" class="mt-3 block h-auto w-full" role="group" aria-label="charger brick sticker spot">
        <rect x="8" y="8" width="140" height="72" rx="7" class="fill-ground stroke-ink" stroke-width="0.9"></rect>
        <path d="M 148 44 C 156 44, 158 52, 170 52" class="fill-none stroke-ink-soft" stroke-width="1.4" stroke-linecap="round"></path>
        {brick.map((spot) => <SpotPlot spot={spot} />)}
      </svg>

      <dl class="data mt-6 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 border-t pt-3 lowercase text-ink-soft">
        <dt>drawn</dt><dd class="text-ink">astra</dd>
        <dt>part</dt><dd class="text-ink">hp victus 15, fb3</dd>
        <dt>sheet</dt><dd class="text-ink">1 of 1, rev a</dd>
        <dt>legend</dt>
        <dd class="flex flex-wrap items-center gap-x-3 gap-y-1 text-ink">
          <span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 border border-dashed border-rule-strong"></span>open</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block size-2.5 bg-ink"></span>taken</span>
        </dd>
      </dl>
    </div>
  </div>
</div>
