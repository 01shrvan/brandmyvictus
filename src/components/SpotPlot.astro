---
import type { SpotState } from "@/lib/auction";
import { formatInr, formatUsd } from "@/lib/money";

interface Props {
  spot: SpotState;
  interactive?: boolean;
}

const { spot, interactive = true } = Astro.props;
const { id, x, y, w, h, leader, min, label } = spot;
const brand = leader?.brand ?? "";
const brandSize = leader ? Math.max(4, Math.min(h * 0.28, (w - 12) / Math.max(brand.length * 0.56, 1))) : 0;
const price = leader ? leader.amount : min;
const aria = leader
  ? `spot ${id}, ${label}, held by ${brand} at ${formatInr(leader.amount)}, outbid from ${formatInr(min)}`
  : `spot ${id}, ${label}, open, bid from ${formatInr(min)}`;
---

<g
  data-spot={id}
  data-open-bid={interactive ? id : undefined}
  class:list={[interactive && "cursor-pointer outline-none"]}
  tabindex={interactive ? "0" : undefined}
  role={interactive ? "button" : undefined}
  aria-label={interactive ? aria : undefined}
>
  <rect class:list={["plot", leader && "plot-taken"]} x={x} y={y} width={w} height={h} rx="2.4"></rect>
  <text x={x + 4} y={y + 7.4} font-size="4.6" class="svg-mono plot-no">{String(id).padStart(2, "0")}</text>
  {
    leader && (
      <text
        x={x + w / 2}
        y={y + h / 2 + 0.8}
        font-size={brandSize.toFixed(2)}
        text-anchor="middle"
        dominant-baseline="middle"
        class="svg-sans plot-brand"
      >
        {brand}
      </text>
    )
  }
  <text x={x + w - 4} y={y + h - 3.6} font-size="4" text-anchor="end" class="svg-mono plot-price money-inr">{formatInr(price)}</text>
  <text x={x + w - 4} y={y + h - 3.6} font-size="4" text-anchor="end" class="svg-mono plot-price money-usd">{formatUsd(price)}</text>
</g>
