---
import type { SpotState } from "@/lib/auction";
import SpotPlot from "@/components/SpotPlot.astro";
import { LID } from "@/lib/site";

interface Props {
  spots: SpotState[];
  interactive?: boolean;
  class?: string;
}

const { spots, interactive = true, class: className } = Astro.props;
const { w: W, h: H, mark } = LID;
---

<svg viewBox="-24 -26 406 305" class:list={["block h-auto w-full", className]} role="group" aria-label="lid, sticker spots to scale">
  <g class="stroke-ink-dim" stroke-width="0.35" fill="none">
    <path d={`M 0 -5 V -20 M ${W} -5 V -20 M -5 0 H -20 M -5 ${H} H -20`}></path>
    <path d={`M 0 -14 H ${W} M -14 0 V ${H}`}></path>
    <path d={`M -2.2 -11.8 L 2.2 -16.2 M ${W - 2.2} -11.8 L ${W + 2.2} -16.2 M -16.2 2.2 L -11.8 -2.2 M -16.2 ${H + 2.2} L -11.8 ${H - 2.2}`} stroke-width="0.6"></path>
  </g>
  <rect x={W / 2 - 16} y="-19" width="32" height="10" class="fill-panel"></rect>
  <text x={W / 2} y="-13.6" font-size="5" text-anchor="middle" dominant-baseline="middle" class="svg-mono fill-ink-soft">357.9</text>
  <rect x="-19" y={H / 2 - 12} width="10" height="24" class="fill-panel"></rect>
  <text x="-14" y={H / 2} font-size="5" text-anchor="middle" dominant-baseline="middle" transform={`rotate(-90 -14 ${H / 2})`} class="svg-mono fill-ink-soft">255</text>

  <rect x="0" y="0" width={W} height={H} rx="10" class="fill-lid stroke-lid" stroke-width="0.7"></rect>
  <rect x="3" y="3" width={W - 6} height={H - 6} rx="8" class="fill-none stroke-lid-edge" stroke-width="0.5"></rect>

  <path d={`M ${mark.x - 8} ${mark.y - 7} L ${mark.x} ${mark.y + 8} L ${mark.x + 8} ${mark.y - 7}`} class="fill-none stroke-on-lid-dim" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"></path>

  <path d={`M 40 ${H - 9} H ${W - 40}`} class="stroke-lid-edge" stroke-width="0.6"></path>

  {spots.map((spot) => <SpotPlot spot={spot} interactive={interactive} />)}
</svg>
